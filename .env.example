# Database Configuration
DATABASE_PATH=./fantasy_football.db

# Server Configuration
PORT=8000
HTTPS_PORT=8443
NODE_ENV=development

# SSL Certificate Configuration (optional)
# SSL_CERT=./certs/cert.pem
# SSL_KEY=./certs/key.pem

# Authentication Configuration
# Generate with: node server/auth/generateHash.js
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
SESSION_SECRET=your_random_session_secret_here

# Tank01 NFL API Configuration
# Get your API key from: https://rapidapi.com/tank01/api/tank01-nfl-live-in-game-real-time-statistics-nfl
TANK01_API_KEY=your_tank01_api_key_here

# Scoring Configuration (optional - defaults are in database)
PASSING_TD_POINTS=4
RUSHING_TD_POINTS=6
RECEIVING_TD_POINTS=6
# Tailscale admin access (see docs/CRON.md "Admin access paths")
TAILSCALE_PORT=8001
TAILSCALE_ADMIN_LOGINS=you@example.com
TAILSCALE_HOSTNAME=yourhost.your-tailnet.ts.net

# Local Qwen for the live play reviewer (scripts/live-review.js). Any OpenAI-compatible
# server (mlx_lm.server / mlx-serve, Ollama, vLLM). Keep it on the tailnet: no auth.
QWEN_BASE_URL=http://your-qwen-host:8080/v1
QWEN_MODEL=your-model-id
# QWEN_API_KEY=only-if-your-server-checks-one

# Public site the live watchdog probes every 2 min (site down = critical email)
PUBLIC_SITE_URL=https://peninsulafootball.com
